# Database (PostgreSQL). Works with Neon, Supabase, Railway, RDS, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/revalor"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional - leave blank to hide Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Service
# If unset, the app runs the AI scanner in DEMO MODE with realistic mock results.
AI_PROVIDER="demo"          # "demo" | "anthropic" | "openai"
AI_API_KEY=""

# Maps
# If unset, "Find a Recycler" renders a static demo map with listed partners.
NEXT_PUBLIC_MAPS_PROVIDER="demo"   # "demo" | "google" | "osm"
NEXT_PUBLIC_MAPS_API_KEY=""

# File storage (optional - defaults to local /public/uploads in demo mode)
STORAGE_PROVIDER="local"    # "local" | "s3"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
